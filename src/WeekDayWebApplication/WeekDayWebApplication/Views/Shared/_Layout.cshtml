@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment hostingEnv

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WeekDayWebApplication</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="site-nav" aria-label="Main navigation">
        <div class="container nav-content">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="brand">WeekDayWebApplication</a>
            <div class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Home" asp-action="PwdHash">Password generator</a>
                <a asp-area="" asp-controller="Data" asp-action="Index">Save data</a>
                <a asp-area="" asp-controller="Data" asp-action="ShowData">Show saved data</a>
            </div>
        </div>
    </nav>

    <partial name="_CookieConsentPartial" />

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2019-@DateTime.UtcNow.Year - WeekDayWebApplication (Stage: @hostingEnv.EnvironmentName)</p>
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
