@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <aside id="cookieConsent" class="cookie-consent" role="alert">
        <div class="container">
            <p>This application uses only essential cookies.</p>
            <div class="button-row">
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-secondary">Learn more</a>
                <button type="button" class="btn btn-primary" data-cookie-string="@cookieString">Accept</button>
            </div>
        </div>
    </aside>
}
