@{
    ViewData["Title"] = "Password generator";
}
<div class="container narrow">
    <h1>Password generator</h1>

    <div class="alert alert-warning" role="alert">
        Version 2 intentionally produces different passwords from the legacy PwdHash algorithm.
        Change credentials at each destination before relying on a newly generated password.
    </div>

    <p>
        Password derivation runs locally in your browser. The complete hostname is used as the
        security boundary, so different <code>azurewebsites.net</code> applications receive different passwords.
    </p>

    <form id="passwordGenerator" novalidate>
        <div class="form-group">
            <label for="theSiteDomain">Site address</label>
            <input type="url" class="form-control" name="domain" id="theSiteDomain"
                   value="https://www.example.com/" inputmode="url" autocomplete="off" required>
            <small class="form-text text-muted">Only HTTP and HTTPS addresses are accepted.</small>
        </div>
        <div class="form-group">
            <label for="theSitePassword">Master password</label>
            <input type="password" class="form-control" name="sitePassword" id="theSitePassword"
                   minlength="12" maxlength="1024" autocomplete="new-password" autocapitalize="none"
                   spellcheck="false" required>
            <small class="form-text text-muted">Use at least 12 characters; this value is cleared after generation.</small>
        </div>
        <div class="form-group">
            <label for="theHashedPassword">Derived password</label>
            <input type="password" readonly class="form-control" name="hashedPassword" id="theHashedPassword"
                   autocomplete="off" aria-describedby="generatorStatus">
        </div>
        <div class="button-row">
            <button type="submit" id="generate" class="btn btn-primary">Generate</button>
            <button type="button" id="copy" class="btn btn-secondary" disabled>Copy</button>
            <button type="button" id="toggleVisibility" class="btn btn-secondary" disabled>Show</button>
        </div>
        <p id="generatorStatus" class="status" role="status" aria-live="polite"></p>
    </form>
</div>

@section Scripts {
    <script src="~/js/password-generator.js" asp-append-version="true"></script>
    <script src="~/js/password-generator-ui.js" asp-append-version="true"></script>
}
